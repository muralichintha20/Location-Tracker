<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LocationHeatMap.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    Title="MainView">

    <Grid RowDefinitions="Auto,*,Auto">

        <Label Text="Location Heat Map"
               FontSize="20"
               Padding="12"
               BackgroundColor="#EEEEEE" />

        <maps:Map x:Name="HeatMap"
                  Grid.Row="1"
                  MapType="Street"
                  IsShowingUser="True" />

        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="12" BackgroundColor="#CCFFFFFF">
            <Label Text="{Binding Status}" FontSize="14" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="{Binding TrackButtonText}"
                        Command="{Binding ToggleTrackingCommand}"
                        HorizontalOptions="FillAndExpand"/>

                <Button Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        HorizontalOptions="FillAndExpand"/>

                <Button Text="Clear"
                        Command="{Binding ClearCommand}"
                        HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

            <Label Text="{Binding LastPointText}" FontSize="12" TextColor="#333333" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>